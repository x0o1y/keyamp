(ert-deftest keyamp-test-indicate-read-defer ()
  "Keep the first deadline for repeats, rearm for a new command, ignore stale work."
  (let ((keyamp-indicate-read-cleanup nil)
        (keyamp-command-indicator 'command)
        (keyamp-read-indicator 'read)
        (mode-line-front-space 'command)
        (keyamp-read-screen-commands-hash (make-hash-table))
        (this-command 'alpha)
        (last-command 'alpha)
        timers canceled reads)
    (cl-letf (((symbol-function 'run-with-timer)
               (lambda (&rest Args) (push Args timers) Args))
              ((symbol-function 'cancel-timer)
               (lambda (Timer) (push Timer canceled)))
              ((symbol-function 'keyamp-blink-stop) #'ignore)
              ((symbol-function 'keyamp-indicate-read)
               (lambda ()
                 (should-not keyamp-indicate-read-cleanup)
                 (setq mode-line-front-space keyamp-read-indicator)
                 (push t reads))))
      (keyamp-indicate-read-defer)
      (should (= (length timers) 1))
      (should (equal (seq-take (car timers) 2)
                     (list (* keyamp-blink-duration 2) nil)))
      (let ((old keyamp-indicate-read-cleanup)
            (tick (nth 2 (car timers))))
        (keyamp-indicate-read-defer)
        (should (= (length timers) 1))
        (setq this-command 'beta)
        (keyamp-indicate-read-defer)
        (should (= (length timers) 2))
        (should (= (length canceled) 1))
        (let ((next keyamp-indicate-read-cleanup))
          (funcall old)
          (funcall tick)
          (should-not reads)
          (should (eq keyamp-indicate-read-cleanup next)))
        (funcall (nth 2 (car timers)))
        (should (= (length reads) 1))
        (should-not keyamp-indicate-read-cleanup)
        (funcall (nth 2 (car timers)))
        (should (= (length reads) 1))
        (setq last-command this-command)
        (keyamp-indicate-read-defer)
        (should (= (length timers) 2))
        (setq mode-line-front-space keyamp-command-indicator)
        (keyamp-indicate-read-defer)
        (keyamp-cancel-indicate-read-timer)
        (funcall (nth 2 (car timers)))
        (should (= (length reads) 1))))))

