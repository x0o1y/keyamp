(ert-deftest keyamp-test-convert-kbd-str ()
  (let ((keyamp--convert-table '(("a" . "x") ("b" . "y"))))
    (should (string-equal (keyamp--convert-kbd-str "a b c") "x y c"))))

(ert-deftest keyamp-test-standard-to-input-method-list ()
  (let ((keyamp-input-methods-to-std
         '(("й" . "q") ("ק" . "e") ("ק2" . "q"))))
    (should
     (equal (keyamp--std-to-non-ascii-list "q") '("й" "ק2")))
    (should-not (keyamp--std-to-non-ascii-list "z"))))

(ert-deftest keyamp-test-standard-to-input-method-vector ()
  (let ((keyamp-input-methods-to-std '(("й" . "q") ("ק" . "q"))))
    (should
     (equal (keyamp-standard-to-input-method-vector "q")
            (list [?й] [?ק])))))

(ert-deftest keyamp-test-unless-kbd-macro ()
  (let ((defining-kbd-macro nil)
        (executing-kbd-macro nil))
    (should (keyamp-unless-kbd-macro)))
  (let ((defining-kbd-macro t)
        (executing-kbd-macro nil))
    (should-not (keyamp-unless-kbd-macro)))
  (let ((defining-kbd-macro nil)
        (executing-kbd-macro t))
    (should-not (keyamp-unless-kbd-macro))))

(ert-deftest keyamp-test-lookup-key ()
  (let ((map (make-sparse-keymap)))
    (define-key map [?a] 'alpha)
    (should (eq (keyamp-lookup-key map ?a) 'alpha))
    (should-not (keyamp-lookup-key map ?b))))

(ert-deftest keyamp-test-toggle-layout-keymap ()
  (let ((keyamp--convert-table '(("a" . "x") ("b" . "y")))
        (key-translation-map (make-sparse-keymap)))
    (toggle-std-to-cur-layout-keymap t)
    (should (equal (lookup-key key-translation-map (kbd "a")) [?x]))
    (should (equal (lookup-key key-translation-map (kbd "b")) [?y]))
    (toggle-std-to-cur-layout-keymap)
    (should-not (lookup-key key-translation-map (kbd "a")))
    (should-not (lookup-key key-translation-map (kbd "b")))))

(ert-deftest keyamp-test-map-std ()
  (let ((keyamp-ascii-chars '(?a ?b))
        (keyamp-input-methods-to-std '(("й" . "a")))
        (map (make-sparse-keymap)))
    (keyamp--map-std map 'ignore)
    (should (eq (lookup-key map (kbd "a")) 'ignore))
    (should (eq (lookup-key map (kbd "b")) 'ignore))
    (should (eq (lookup-key map (kbd "й")) 'ignore))))

