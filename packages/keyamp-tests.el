(ert-deftest keyamp-test-blink-stop ()
  "Cancel both timers and only their own hook, even after restarting."
  (let ((post-command-hook '(ignore))
        (keyamp-blink-cleanup nil)
        timers canceled colors)
    (cl-letf (((symbol-function 'timerp) (lambda (Timer) (consp Timer)))
              ((symbol-function 'run-with-timer)
               (lambda (&rest Args) (push Args timers) Args))
              ((symbol-function 'cancel-timer)
               (lambda (Timer) (push Timer canceled)))
              ((symbol-function 'keyamp-indicator-color)
               (lambda (&rest Args) (push Args colors))))
      (keyamp-blink-start "one" "two")
      (let ((old keyamp-blink-cleanup)
            (on (car timers)))
        (apply (nth 2 on) (nthcdr 3 on))
        (let ((off (car timers)))
          (should (equal colors '(("one" t))))
          (apply (nth 2 on) (nthcdr 3 on))
          (should (equal canceled (list off)))
          (let ((off (car timers)))
            (funcall (nth 2 off))
            (should (equal (car colors) '("two")))
            (keyamp-blink-start "three" "four")
            (should (= (length canceled) 3))
            (setq colors nil)
            (funcall old)
            (apply (nth 2 on) (nthcdr 3 on))
            (funcall (nth 2 off))
            (should-not colors)
            (should (memq keyamp-blink-cleanup post-command-hook))
            (run-hooks 'post-command-hook)
            (should-not keyamp-blink-cleanup)
            (should (equal post-command-hook '(ignore)))
            (should (= (length canceled) 4))
            (keyamp-blink-stop)
            (should (= (length canceled) 4))))))))

(ert-deftest keyamp-test-blinking-sleep ()
  "Sleep overrides only blink weight, without owning timers."
  (with-temp-buffer
    (insert-file-contents (expand-file-name "~/.emacs.d/settings/timer-init.el"))
    (goto-char (point-min))
    (search-forward "(defun keyamp-blinking-sleep ")
    (beginning-of-line)
    (eval (read (current-buffer)) t))
  (let ((post-command-hook nil)
        (keyamp-blink-cleanup nil)
        timers colors)
    (cl-letf (((symbol-function 'run-with-timer)
               (lambda (&rest Args) (push Args timers) Args))
              ((symbol-function 'timerp) (lambda (Timer) (consp Timer)))
              ((symbol-function 'cancel-timer) #'ignore)
              ((symbol-function 'keyamp-indicator-color)
               (lambda (&rest Args) (push Args colors))))
      (unwind-protect
          (progn
            (keyamp-blink-start "one" "two")
            (advice-add 'keyamp-blinking :override #'keyamp-blinking-sleep)
            (let ((on (car timers)))
              (apply (nth 2 on) (nthcdr 3 on))
              (should (equal (car colors) '("one" nil)))
              (funcall (nth 2 (car timers)))
              (should (equal (car colors) '("two")))
              (advice-remove 'keyamp-blinking #'keyamp-blinking-sleep)
              (apply (nth 2 on) (nthcdr 3 on))
              (should (equal (car colors) '("one" t)))))
        (advice-remove 'keyamp-blinking #'keyamp-blinking-sleep)
        (keyamp-blink-stop)))))

(ert-deftest keyamp-test-vterm-navigation-remaps ()
  "Vterm remaps navigation commands, not text input."
  (let ((vterm-mode-map (make-sparse-keymap)))
    (with-temp-buffer
      (insert-file-contents
       (expand-file-name "~/.emacs.d/packages/keyamp.el"))
      (goto-char (point-min))
      (search-forward "(with-eval-after-load 'vterm")
      (beginning-of-line)
      (dolist (form (cddr (read (current-buffer))))
        (when (and (eq (car-safe form) 'keyamp--remap)
                   (eq (cadr form) 'vterm-mode-map))
          (eval form t))))
    (dolist (pair '((previous-line . vt-previous-line) (next-line . vt-next-line)
                    (bchar . vt-bchar) (fchar . vt-fchar)))
      (should (eq (lookup-key vterm-mode-map (vector 'remap (car pair)))
                  (cdr pair))))
    (should-not (lookup-key vterm-mode-map [remap vterm--self-insert]))))

