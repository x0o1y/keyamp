(ert-deftest keyamp-test-window-layout-map ()
  "Use the right leader and the standard repeat remaps without entering command mode."
  (should (eq (keymap-lookup keyamp-command-map (keyamp--convert-kbd-str "-"))
              'window-layout-next))
  (should (eq (keymap-lookup keyamp-rleader-map (keyamp--convert-kbd-str "-"))
              'window-layout-save))
  (let ((this-command 'window-layout-next)
        (register-alist nil)
        (window-layout-current nil)
        (keyamp-insert-p t)
        map)
    (window-configuration-to-register ?1)
    (cl-letf (((symbol-function 'keyamp-repeat-init)
               (lambda (Map &rest _) (setq map Map)))
              ((symbol-function 'keyamp-command)
               (lambda () (ert-fail "Unexpected command-mode activation"))))
      (window-layout-next))
    (should (eq (lookup-key map [remap newline]) 'window-layout-next))
    (should (eq (lookup-key map [remap open-line]) 'window-layout-prev))
    (should-not (lookup-key map [?x]))))

(ert-deftest keyamp-test-minibuffer-setup-command ()
  "Install the shared repeat map only when a command identity is present."
  (let ((hook (cl-find-if
               (lambda (Fun) (equal (documentation Fun) "auto repeat"))
               minibuffer-setup-hook)))
    (should hook)
    (dolist (cmd '(nil vt-ssh-confirm))
      (dolist (insertp '(nil t))
        (let ((this-command cmd)
              (keyamp-insert-p insertp)
              map entered indicated)
          (cl-letf (((symbol-function 'keyamp-command)
                     (lambda () (setq entered t)))
                    ((symbol-function 'keyamp-repeat-init)
                     (lambda (Map &rest _) (setq map Map)))
                    ((symbol-function 'keyamp-command-execute)
                     (lambda (Cmd) (setq indicated Cmd))))
            (funcall hook))
          (should (eq entered (and cmd insertp t)))
          (if cmd
              (progn
                (should (eq (keymap-lookup map (keyamp--convert-kbd-str "y"))
                            'keyamp-insert-minibuffer))
                (should (eq indicated 'keyamp--hook-indicate)))
            (should-not map)
            (should-not indicated)))))))

