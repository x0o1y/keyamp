(ert-deftest keyamp-test-touch-prefix ()
  "Retain original settings across repeated prefixes and restore them once."
  (let ((which-key-mode t)
        (which-key-idle-delay 1)
        (which-key-show-prefix t)
        (echo-keystrokes 2)
        (keyamp-touch-prefix-cleanup nil)
        unread-command-events
        timers toggles canceled)
    (cl-letf (((symbol-function 'which-key-mode)
               (lambda (&optional Arg) (push Arg toggles)))
              ((symbol-function 'cancel-timer)
               (lambda (Timer) (push Timer canceled)))
              ((symbol-function 'run-with-idle-timer)
               (lambda (&rest Args)
                 (push Args timers) Args)))
      (keyamp-touch-prefix "a")
      (should (= which-key-idle-delay 0.1))
      (should-not which-key-show-prefix)
      (should (= echo-keystrokes 0))
      (should (equal unread-command-events '((no-record . 97))))
      (should (equal (seq-take (car timers) 2) '(4 nil)))
      (let ((old keyamp-touch-prefix-cleanup))
        (keyamp-touch-prefix "b")
        (should (= (length timers) 1))
        (should (eq keyamp-touch-prefix-cleanup old))
        (funcall (nth 2 (car timers)))
        (should (= which-key-idle-delay 1))
        (should which-key-show-prefix)
        (should (= echo-keystrokes 2))
        (should-not keyamp-touch-prefix-cleanup)
        (should (= (length canceled) 1))
        (keyamp-touch-prefix "c")
        (let ((next keyamp-touch-prefix-cleanup))
          (funcall old)
          (should (eq keyamp-touch-prefix-cleanup next))
          (should (= which-key-idle-delay 0.1))
          (funcall next)
          (should (= which-key-idle-delay 1)))))))

(ert-deftest keyamp-test-touch-prefix-disabled ()
  "Do not enable disabled which-key, including when restoring pending settings."
  (let ((which-key-mode nil)
        (which-key-idle-delay 1)
        (which-key-show-prefix t)
        (echo-keystrokes 2)
        (keyamp-touch-prefix-cleanup nil)
        unread-command-events tick)
    (cl-letf (((symbol-function 'which-key-mode)
               (lambda (&optional _) (should which-key-mode)))
              ((symbol-function 'cancel-timer) #'ignore)
              ((symbol-function 'run-with-idle-timer)
               (lambda (_ _ Fun) (setq tick Fun) 'timer)))
      (keyamp-touch-prefix "a")
      (should (equal unread-command-events '((no-record . 97))))
      (should-not tick)
      (should (= echo-keystrokes 2))
      (setq which-key-mode t)
      (keyamp-touch-prefix "b")
      (should tick)
      (setq which-key-mode nil)
      (funcall tick)
      (should-not which-key-mode)
      (should-not keyamp-touch-prefix-cleanup)
      (should (= which-key-idle-delay 1))
      (should which-key-show-prefix)
      (should (= echo-keystrokes 2)))))

(ert-deftest keyamp-test-double-press ()
  "Recognize pairs and prevent an old timeout from clearing a new wait."
  (let ((keyamp-double-press-cleanup nil)
        (this-command 'alpha)
        (last-command 'alpha)
        timers canceled commands)
    (cl-letf (((symbol-function 'keyamp-unless-kbd-macro) (lambda () t))
              ((symbol-function 'keyamp-command-execute)
               (lambda (Cmd) (push Cmd commands)))
              ((symbol-function 'cancel-timer)
               (lambda (Timer) (push Timer canceled)))
              ((symbol-function 'run-with-timer)
               (lambda (&rest Args)
                 (push Args timers) Args)))
      (keyamp-double-press 'beta)
      (should keyamp-double-press-cleanup)
      (should-not commands)
      (should (equal (seq-take (car timers) 2)
                     (list keyamp-double-press-timeout nil)))
      (let ((old keyamp-double-press-cleanup))
        (keyamp-double-press 'beta)
        (should (equal commands '(beta)))
        (should-not keyamp-double-press-cleanup)
        (should (= (length canceled) 1))
        (keyamp-double-press 'beta)
        (let ((next keyamp-double-press-cleanup))
          (funcall old)
          (should (eq keyamp-double-press-cleanup next))
          (should (= (length canceled) 1))
          (keyamp-double-press 'beta)
          (should (equal commands '(beta beta)))
          (should-not keyamp-double-press-cleanup))
        (keyamp-double-press 'beta)
        (funcall keyamp-double-press-cleanup)
        (should-not keyamp-double-press-cleanup)
        (keyamp-double-press 'beta)
        (should (equal commands '(beta beta)))
        (funcall keyamp-double-press-cleanup)))))

(ert-deftest keyamp-test-double-press-command-change ()
  "Rearm after a different command and never execute pairs in keyboard macros."
  (let ((keyamp-double-press-cleanup nil)
        (this-command 'alpha)
        (last-command 'alpha)
        (executing-kbd-macro nil)
        (defining-kbd-macro nil)
        commands)
    (cl-letf (((symbol-function 'run-with-timer)
               (lambda (_ _ Fun) Fun))
              ((symbol-function 'cancel-timer) #'ignore)
              ((symbol-function 'keyamp-command-execute)
               (lambda (Cmd) (push Cmd commands))))
      (keyamp-double-press 'beta)
      (let ((old keyamp-double-press-cleanup))
        (setq this-command 'gamma)
        (keyamp-double-press 'delta)
        (should-not commands)
        (funcall old)
        (should keyamp-double-press-cleanup))
      (setq last-command 'gamma executing-kbd-macro t)
      (keyamp-double-press 'delta)
      (should-not commands)
      (setq executing-kbd-macro nil)
      (keyamp-double-press 'delta)
      (should (equal commands '(delta)))
      (should-not keyamp-double-press-cleanup))))

(ert-deftest keyamp-test-defer-command ()
  "Execute once and clear the completed request before invoking its command."
  (let ((keyamp-defer-command-cleanup nil)
        timer-args canceled commands)
    (cl-letf (((symbol-function 'keyamp-unless-kbd-macro) (lambda () t))
              ((symbol-function 'cancel-timer)
               (lambda (Timer) (push Timer canceled)))
              ((symbol-function 'keyamp-command-execute)
               (lambda (Cmd)
                 (should-not keyamp-defer-command-cleanup)
                 (push Cmd commands)))
              ((symbol-function 'run-with-timer)
               (lambda (&rest Args)
                 (setq timer-args Args)
                 'timer)))
      (keyamp-defer-command 'alpha 0.2)
      (should (functionp keyamp-defer-command-cleanup))
      (should (equal (seq-take timer-args 2) '(0.2 nil)))
      (funcall (nth 2 timer-args))
      (funcall (nth 2 timer-args))
      (should (equal commands '(alpha)))
      (should (equal canceled '(timer))))))

(ert-deftest keyamp-test-cancel-defer-command-timer ()
  "Cancel a deferred command once and ignore its stale callback."
  (let ((keyamp-defer-command-cleanup nil)
        tick canceled)
    (cl-letf (((symbol-function 'keyamp-unless-kbd-macro) (lambda () t))
              ((symbol-function 'run-with-timer)
               (lambda (_ _ Fun) (setq tick Fun) 'timer))
              ((symbol-function 'cancel-timer)
               (lambda (Timer) (push Timer canceled)))
              ((symbol-function 'keyamp-command-execute)
               (lambda (_) (ert-fail "Canceled command executed"))))
      (keyamp-defer-command 'alpha 0.2)
      (keyamp-cancel-defer-command-timer)
      (keyamp-cancel-defer-command-timer)
      (funcall tick)
      (should (equal canceled '(timer)))
      (should-not keyamp-defer-command-cleanup))))

(ert-deftest keyamp-test-defer-command-queue ()
  "Preserve queued commands and never clear a newer request from an older one."
  (let ((keyamp-defer-command-cleanup nil)
        timers commands)
    (cl-letf (((symbol-function 'keyamp-unless-kbd-macro) (lambda () t))
              ((symbol-function 'run-with-timer)
               (lambda (_ _ Fun) (push Fun timers) Fun))
              ((symbol-function 'cancel-timer) #'ignore)
              ((symbol-function 'keyamp-command-execute)
               (lambda (Cmd) (push Cmd commands))))
      (keyamp-defer-command 'alpha 0.2)
      (let ((old keyamp-defer-command-cleanup)
            (tick (car timers)))
        (keyamp-defer-command 'beta 0.2)
        (let ((next keyamp-defer-command-cleanup))
          (funcall tick)
          (should (equal commands '(alpha)))
          (should (eq keyamp-defer-command-cleanup next))
          (funcall old)
          (should (eq keyamp-defer-command-cleanup next))
          (funcall (car timers))
          (should (equal commands '(beta alpha)))
          (should-not keyamp-defer-command-cleanup))))))

(ert-deftest keyamp-test-defer-command-skips-macros ()
  "Do not schedule absent commands or schedule and cancel within macros."
  (let ((keyamp-defer-command-cleanup nil)
        (executing-kbd-macro nil)
        (defining-kbd-macro nil)
        tick canceled)
    (cl-letf (((symbol-function 'run-with-timer)
               (lambda (_ _ Fun) (setq tick Fun) 'timer))
              ((symbol-function 'cancel-timer)
               (lambda (Timer) (push Timer canceled))))
      (keyamp-defer-command nil)
      (should-not tick)
      (setq executing-kbd-macro t)
      (keyamp-defer-command 'alpha 0.2)
      (should-not tick)
      (setq executing-kbd-macro nil)
      (keyamp-defer-command 'alpha 0.2)
      (should tick)
      (setq executing-kbd-macro t)
      (keyamp-cancel-defer-command-timer)
      (should keyamp-defer-command-cleanup)
      (should-not canceled)
      (setq executing-kbd-macro nil)
      (keyamp-cancel-defer-command-timer)
      (should (equal canceled '(timer))))))

