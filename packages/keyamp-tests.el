(ert-deftest keyamp-test-map-leader ()
  (let ((map (make-sparse-keymap)))
    (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t)))
      (keyamp--map-leader map '(alpha . beta)))
    (should (eq (lookup-key map (kbd "SPC")) 'alpha))
    (should (eq (lookup-key map (kbd "<backspace>")) 'beta)))
  (let ((map (make-sparse-keymap)))
    (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) nil)))
      (keyamp--map-leader map '(alpha . beta)))
    (should (eq (lookup-key map (kbd "SPC")) 'alpha))
    (should (eq (lookup-key map (kbd "DEL")) 'beta))))

(ert-deftest keyamp-test-map-special-keys ()
  (let ((map (make-sparse-keymap)))
    (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t)))
      (keyamp--map-tab map alpha)
      (keyamp--map-return map beta))
    (keyamp--map-backtab map gamma)
    (keyamp--map-escape map delta)
    (should (eq (lookup-key map (kbd "<tab>")) 'alpha))
    (should (eq (lookup-key map (kbd "<return>")) 'beta))
    (should (eq (lookup-key map (kbd "<backtab>")) 'gamma))
    (should (eq (lookup-key map (kbd "<escape>")) 'delta))))

(ert-deftest keyamp-test-advice-add-macro ()
