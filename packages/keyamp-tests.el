(ert-deftest keyamp-test-virtual-leader-init ()
  "Retire the previous leader before installing a new self-contained timeout."
  (let ((keyamp-virtual-leader-cleanup nil)
        canceled
        timer-args
        deactivate)
    (setq keyamp-virtual-leader-cleanup (lambda () (setq canceled t)))
    (cl-letf (((symbol-function 'keyamp-unless-kbd-macro) (lambda () t))
              ((symbol-function 'this-command-keys) (lambda () "u"))
              ((symbol-function 'keyamp--convert-kbd-str) #'identity)
              ((symbol-function 'keyamp-standard-to-input-method-vector)
               (lambda (_) nil))
              ((symbol-function 'set-transient-map)
               (lambda (_) (lambda () (setq deactivate t))))
              ((symbol-function 'cancel-timer) #'ignore)
              ((symbol-function 'run-with-timer)
               (lambda (&rest Args)
                 (setq timer-args Args)
                 'new-timer)))
