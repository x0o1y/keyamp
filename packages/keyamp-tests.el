    (cl-letf (((symbol-function 'timerp) (lambda (_) t))
              ((symbol-function 'keyamp-unless-kbd-macro) (lambda () t))
              ((symbol-function 'keyamp-command-execute)
               (lambda (Cmd) (setq command Cmd))))
      (keyamp-double-press 'beta))
    (should (eq command 'beta))
    (should-not keyamp-double-press-timer))
  (let ((keyamp-double-press-timer nil)
        timer-args)
    (cl-letf (((symbol-function 'timerp) (lambda (_) nil))
              ((symbol-function 'run-with-timer)
               (lambda (&rest Args)
                 (setq timer-args Args)
                 'timer)))
      (keyamp-double-press 'beta))
    (should (eq keyamp-double-press-timer 'timer))
    (should (= (car timer-args) keyamp-double-press-timeout))))

