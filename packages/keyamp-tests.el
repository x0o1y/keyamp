(ert-deftest keyamp-test-touch-prefix ()
  (let ((which-key-idle-delay 1)
        (which-key-show-prefix t)
        (echo-keystrokes 2)
        (keyamp-toggle-which-key-timer nil)
        unread-command-events
        timer-args
        toggle-args)
    (cl-letf (((symbol-function 'timerp) (lambda (_) nil))
              ((symbol-function 'keyamp-toggle-which-key)
               (lambda (&rest Args) (setq toggle-args Args)))
              ((symbol-function 'run-with-idle-timer)
               (lambda (&rest Args)
                 (setq timer-args Args)
                 'timer)))
      (keyamp-touch-prefix "a"))
    (should (equal toggle-args '(0.1 0)))
    (should (equal unread-command-events '((no-record . 97))))
    (should (equal timer-args
                   '(4 nil keyamp-toggle-which-key 1 2 t)))
    (should (eq keyamp-toggle-which-key-timer 'timer))))

