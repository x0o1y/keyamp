(ert-deftest keyamp-test-input-timer-lifecycle ()
  "Ignore stale callbacks and preserve the payload's advice extension point."
  (dolist (hook '(pre-command-hook post-self-insert-hook nil))
    (let ((keyamp-input-timerp t)
          (pre-command-hook nil)
          (post-self-insert-hook nil)
          (keyamp-input-timer-cleanup nil)
          (keyamp-insert-p t)
          timers calls)
      (cl-letf (((symbol-function 'run-with-timer)
                 (lambda (_ _ Fun) (push Fun timers) Fun))
                ((symbol-function 'cancel-timer) #'ignore)
                ((symbol-function 'keyamp-command)
                 (lambda () (push 'command calls))))
        (let ((after (lambda () (push 'after calls))))
          (advice-add 'keyamp-input-timer-payload :after after)
          (unwind-protect
              (progn
                (keyamp-input-timer)
                (let ((old keyamp-input-timer-cleanup)
                      (tick (car timers)))
                  (keyamp-input-timer)
                  (funcall old)
                  (funcall tick)
                  (should-not calls)
                  (should (equal pre-command-hook (list keyamp-input-timer-cleanup)))
                  (should (equal post-self-insert-hook (list keyamp-input-timer-cleanup))))
                (when hook (run-hooks hook))
                (funcall (car timers))
                (should (equal (nreverse calls) (unless hook '(command after))))
                (should-not keyamp-input-timer-cleanup)
                (should-not pre-command-hook)
                (should-not post-self-insert-hook))
            (advice-remove 'keyamp-input-timer-payload after)
            (keyamp-input-timer-cancel)))))))

