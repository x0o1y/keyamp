(ert-deftest keyamp-test-karabiner-lifecycle ()
  (let ((keyamp-karabinerp t)
        (keyamp-insert-hook nil)
        (keyamp-command-hook nil)
        (isearch-mode-hook nil)
        (isearch-mode-end-hook nil)
        (minibuffer-setup-hook nil)
        (kill-emacs-hook nil)
        commandp
        insertp)
    (cl-letf (((symbol-function 'keyamp-command-karabiner)
               (lambda () (setq commandp t)))
              ((symbol-function 'keyamp-insert-karabiner)
               (lambda () (setq insertp t))))
      (keyamp-karabiner-init)
      (should commandp)
      (should (memq 'keyamp-insert-karabiner keyamp-insert-hook))
      (should (memq 'keyamp-command-karabiner keyamp-command-hook))
      (should (memq 'keyamp-karabiner-kill-emacs kill-emacs-hook))
      (keyamp-karabiner-deactivate))
    (should insertp)
    (should-not (memq 'keyamp-insert-karabiner keyamp-insert-hook))
    (should-not (memq 'keyamp-command-karabiner keyamp-command-hook))))

