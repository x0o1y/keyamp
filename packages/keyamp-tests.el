(ert-deftest keyamp-test-virtual-leader-init ()
  (let ((keyamp-virtual-leader-timer 'old-timer)
        (keyamp--deactivate-leader-fun nil)
        canceled
        timer-args
        deactivate)
    (cl-letf (((symbol-function 'keyamp-unless-kbd-macro) (lambda () t))
              ((symbol-function 'this-command-keys) (lambda () "u"))
              ((symbol-function 'keyamp--convert-kbd-str) #'identity)
              ((symbol-function 'keyamp-standard-to-input-method-vector)
               (lambda (_) nil))
              ((symbol-function 'set-transient-map)
               (lambda (_) (lambda () (setq deactivate t))))
              ((symbol-function 'timerp) (lambda (_) t))
              ((symbol-function 'cancel-timer)
               (lambda (Timer) (setq canceled Timer)))
              ((symbol-function 'run-with-timer)
               (lambda (&rest Args)
                 (setq timer-args Args)
                 'new-timer)))
      (keyamp-virtual-leader-init (make-sparse-keymap)))
    (should (eq canceled 'old-timer))
    (should (functionp keyamp--deactivate-leader-fun))
    (funcall keyamp--deactivate-leader-fun)
    (should deactivate)
    (should (equal timer-args
                   (list keyamp-double-press-timeout nil
                         'keyamp--leader-deactivate)))
    (should (eq keyamp-virtual-leader-timer 'new-timer))))

